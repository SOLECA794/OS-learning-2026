# Rust / kernel build artifacts
target/
build/
**/*.rs.bk

# 运行器日志（V2 §11）：make clean 不删除，保持独立目录\nartifacts/\n\n# QEMU / test images (large binaries, never commit)
*.img
*.img.gz
*.sdcard
*.qcow2
*.bin
*.elf
*.iso

# Kernel build outputs
kernel.asm
*.o
*.d

# Logs and profiling artifacts
*.log
logs/
profile/
*.profraw
*.sqlite
*.folded
*.tsv

# Config artifacts (keep presets, ignore generated)
config/.config
config/.config.*
config/config.mk
!config/Kconfig
!config/defconfig-*

# Vendored dependencies (track manifest + lock, vendor generated by CI/tooling)
vendor/
!vendor/*.toml

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local-only files (personal environment notes, never commit)
LOCAL.md
*.local.md

# User-private debug archives
.user-debug/
debug-archive/
